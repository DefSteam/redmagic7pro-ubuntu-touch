CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVPTS_FS=y

CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_DM=y
CONFIG_DM_LINEAR=y
CONFIG_DM_VERITY=y
CONFIG_EXT4_FS=y

CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y

CONFIG_POSIX_MQUEUE=y

# --- Bluetooth BNEP ---
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# --- Permissions / systemd-logind ---
CONFIG_TMPFS_POSIX_ACL=y

# --- ZRAM ---
CONFIG_ZRAM=y
CONFIG_BLK_DEV_ZRAM=y

# Core Security & AppArmor Support
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_APPARMOR=y

# AppArmor Specific Features
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
